rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn() && request.auth.token.role in ["admin", "manager"];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isBuilder() {
      return isSignedIn() && request.auth.token.role == "builder";
    }

    function ownsNewDocument(field) {
      return isBuilder() && request.resource.data[field] == request.auth.uid;
    }

    function ownsExistingDocument(field) {
      return isBuilder() && resource.data[field] == request.auth.uid;
    }

    function ownsUpdatedDocument(field) {
      return ownsExistingDocument(field) && ownsNewDocument(field);
    }

    function ownsProject(projectId) {
      return isBuilder()
        && validId(projectId)
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.builderId == request.auth.uid
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function validId(value) {
      return value is string
        && value.matches("^[A-Za-z0-9_-]{1,128}$");
    }

    function validRequiredString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function validNullableString(value, maxLength) {
      return value == null || (
        value is string
        && value.size() <= maxLength
      );
    }

    function validLocation(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly(["lat", "lng"])
        && value.lat is number
        && value.lat >= -90
        && value.lat <= 90
        && value.lng is number
        && value.lng >= -180
        && value.lng <= 180
      );
    }

    function projectHasCanonicalAssignment(projectId, builderId) {
      return validId(projectId)
        && validId(builderId)
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.builderId == builderId
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == builderId;
    }

    function validProjectDocument(data) {
      return data.keys().hasOnly([
          "builderId", "ownerId", "createdBy", "name", "description", "clientName",
          "address", "status", "createdAt", "updatedAt"
        ])
        && validId(data.builderId)
        && data.ownerId == data.builderId
        && validId(data.createdBy)
        && validRequiredString(data.name, 160)
        && validNullableString(data.description, 2000)
        && validRequiredString(data.clientName, 160)
        && validNullableString(data.address, 500)
        && data.status in ["active", "finished", "on_hold"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validJobDocument(data) {
      return data.keys().hasOnly([
          "projectId", "builderId", "title", "description", "section", "status",
          "reviewNotes", "reviewedBy", "reviewedAt", "importId", "importRow",
          "createdAt", "updatedAt"
        ])
        && validId(data.projectId)
        && validId(data.builderId)
        && validRequiredString(data.title, 160)
        && validNullableString(data.description, 2000)
        && validNullableString(data.section, 120)
        && data.status in ["approved", "pending", "needs_correction", "waiting_review", "completed"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(["reviewNotes"]) || validNullableString(data.reviewNotes, 2000))
        && (!data.keys().hasAny(["reviewedBy"]) || data.reviewedBy == null || validId(data.reviewedBy))
        && (!data.keys().hasAny(["reviewedAt"]) || data.reviewedAt == null || data.reviewedAt is timestamp)
        && (!data.keys().hasAny(["importId"]) || validId(data.importId))
        && (!data.keys().hasAny(["importRow"]) || (
          data.importRow is int && data.importRow > 0 && data.importRow <= 500
        ));
    }

    function validTimeEntryDocument(data) {
      return data.keys().hasOnly([
          "builderId", "projectId", "clockIn", "clockOut", "location", "notes"
        ])
        && validId(data.builderId)
        && validId(data.projectId)
        && data.clockIn is timestamp
        && (data.clockOut == null || data.clockOut is timestamp)
        && validLocation(data.location)
        && validNullableString(data.notes, 1000);
    }

    function activeMarkerAfterMatches(entryId, projectId) {
      return existsAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid)).data.builderId
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid)).data.entryId
          == entryId
        && getAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid)).data.projectId
          == projectId;
    }

    function activeEntryAfterIsValid(entryId, projectId) {
      return validId(entryId)
        && existsAfter(/databases/$(database)/documents/timeTracking/$(entryId))
        && getAfter(/databases/$(database)/documents/timeTracking/$(entryId)).data.builderId
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/timeTracking/$(entryId)).data.projectId
          == projectId
        && getAfter(/databases/$(database)/documents/timeTracking/$(entryId)).data.clockOut == null;
    }

    function requestedNameMatchesAuth(field) {
      return (request.auth.token.name == null && request.resource.data[field] == null)
        || (request.auth.token.name is string
          && request.resource.data[field] == request.auth.token.name);
    }

    function roleClaimIsImmutable() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
    }

    function validToolRequestTransition() {
      return (resource.data.status == "pending" && request.resource.data.status in ["approved", "rejected"])
        || (resource.data.status == "approved" && request.resource.data.status in ["picked_up", "rejected"])
        || (resource.data.status == "picked_up" && request.resource.data.status in ["delivered", "returned"])
        || (resource.data.status == "delivered" && request.resource.data.status == "returned");
    }

    function validMaterialDeliveryTransition() {
      return (resource.data.status == "pending" && request.resource.data.status in ["in_progress", "rejected"])
        || (resource.data.status == "in_progress" && request.resource.data.status in ["delivered", "rejected"]);
    }

    function validRubbishPhotoAt(index, requestId) {
      return request.resource.data.photoPaths.size() <= index || (
        request.resource.data.photoPaths[index] is string
        && request.resource.data.photoPaths[index].matches(
          "^rubbish/" + request.auth.uid + "/" + requestId + "/[^/]+$"
        )
      );
    }

    function validDailyReportPhotoAt(index, builderId, reportId) {
      return request.resource.data.photoPaths.size() <= index || (
        request.resource.data.photoPaths[index] is string
        && request.resource.data.photoPaths[index].matches(
          "^dailyReports/" + builderId + "/" + reportId + "/[^/]+$"
        )
      );
    }

    function canAccessRiskAssessment() {
      return isManager() || (
        isBuilder()
        && resource.data.projectId is string
        && ownsProject(resource.data.projectId)
      );
    }

    function validStockDecrement(materialId, quantity) {
      return exists(/databases/$(database)/documents/storageMaterials/$(materialId))
        && get(/databases/$(database)/documents/storageMaterials/$(materialId)).data.quantity is number
        && getAfter(/databases/$(database)/documents/storageMaterials/$(materialId)).data.quantity is number
        && getAfter(/databases/$(database)/documents/storageMaterials/$(materialId)).data.quantity
          == get(/databases/$(database)/documents/storageMaterials/$(materialId)).data.quantity - quantity
        && getAfter(/databases/$(database)/documents/storageMaterials/$(materialId)).data.quantity >= 0;
    }

    match /users/{userId} {
      allow get, list: if isManager() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(["role"]);
      allow update: if roleClaimIsImmutable() && (
        isManager() || (isSignedIn() && request.auth.uid == userId)
      );
      allow delete: if isManager() || (isSignedIn() && request.auth.uid == userId);
    }

    match /projects/{projectId} {
      allow read: if isManager() || (
        isBuilder()
        && resource.data.builderId == request.auth.uid
        && resource.data.ownerId == resource.data.builderId
      );
      allow create: if false;
      allow update: if isManager()
        && validProjectDocument(resource.data)
        && validProjectDocument(request.resource.data)
        && request.resource.data.builderId == resource.data.builderId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "description", "clientName", "address", "status", "updatedAt"
        ]);
      allow delete: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create: if isManager()
        && request.resource.data.keys().hasOnly([
          "name", "normalizedName", "createdBy", "createdAt", "updatedAt"
        ])
        && supplierId.matches("^[a-z0-9]+(?:-[a-z0-9]+)*$")
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.normalizedName == supplierId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isManager()
        && request.resource.data.keys().hasOnly([
          "name", "normalizedName", "createdBy", "createdAt", "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.normalizedName == supplierId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow read: if isManager() || (
        isBuilder()
        && resource.data.builderId == request.auth.uid
        && projectHasCanonicalAssignment(resource.data.projectId, resource.data.builderId)
      );
      allow create: if isManager()
        && validId(jobId)
        && validJobDocument(request.resource.data)
        && request.resource.data.status == "approved"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(["reviewNotes"])
          || request.resource.data.reviewNotes == null)
        && (!request.resource.data.keys().hasAny(["reviewedBy"])
          || request.resource.data.reviewedBy == null)
        && (!request.resource.data.keys().hasAny(["reviewedAt"])
          || request.resource.data.reviewedAt == null)
        && !request.resource.data.keys().hasAny(["importId", "importRow"])
        && projectHasCanonicalAssignment(
          request.resource.data.projectId,
          request.resource.data.builderId
        );
      allow update: if validJobDocument(request.resource.data)
        && projectHasCanonicalAssignment(
          request.resource.data.projectId,
          request.resource.data.builderId
        )
        && (isBuilder()
          && resource.data.builderId == request.auth.uid
          && request.resource.data.builderId == request.auth.uid
          && request.resource.data.status == "waiting_review"
          && resource.data.status in ["approved", "needs_correction"]
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        || isManager()
          && resource.data.status == "waiting_review"
          && request.resource.data.status in ["completed", "needs_correction"]
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && validNullableString(request.resource.data.reviewNotes, 2000)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "reviewNotes", "reviewedBy", "reviewedAt", "updatedAt"
          ])
        );
      allow delete: if false;
    }

    match /jobCompletions/{completionId} {
      allow read: if isManager() || ownsExistingDocument("builderId");
      allow create, update, delete: if false;
    }

    match /jobPhotos/{photoId} {
      allow read: if isManager() || (
        isBuilder()
        && resource.data.builderId == request.auth.uid
        && exists(/databases/$(database)/documents/jobs/$(resource.data.jobId))
        && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.builderId
          == request.auth.uid
        && projectHasCanonicalAssignment(
          get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.projectId,
          request.auth.uid
        )
      );
      allow create: if (isManager() || isBuilder())
        && validId(photoId)
        && request.resource.data.keys().hasOnly([
          "jobId", "builderId", "uploadedBy", "kind", "originalPath", "thumbnailPath",
          "fileName", "contentType", "createdAt"
        ])
        && validId(request.resource.data.jobId)
        && validId(request.resource.data.builderId)
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.kind in ["reference", "completion", "feedback"]
        && validRequiredString(request.resource.data.fileName, 180)
        && request.resource.data.contentType is string
        && request.resource.data.contentType.matches("^image/[A-Za-z0-9.+-]+$")
        && request.resource.data.originalPath is string
        && request.resource.data.originalPath.size() <= 512
        && request.resource.data.originalPath.matches(
          "^jobs/" + request.resource.data.jobId + "/" + request.resource.data.builderId
            + "/" + request.resource.data.kind + "/" + photoId + "-[^/]+$"
        )
        && request.resource.data.thumbnailPath is string
        && request.resource.data.thumbnailPath.size() <= 512
        && request.resource.data.thumbnailPath.matches(
          "^jobs/" + request.resource.data.jobId + "/" + request.resource.data.builderId
            + "/" + request.resource.data.kind + "/thumbnails/" + photoId + "-[^/]+$"
        )
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.builderId
          == request.resource.data.builderId
        && projectHasCanonicalAssignment(
          get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.projectId,
          request.resource.data.builderId
        )
        && (
          isManager()
            && request.resource.data.kind == "feedback"
            && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status
              == "waiting_review"
          || isBuilder()
            && request.resource.data.builderId == request.auth.uid
            && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status
              in ["approved", "needs_correction"]
            && request.resource.data.kind in ["reference", "completion"]
        );
      allow update: if false;
      allow delete: if resource.data.uploadedBy == request.auth.uid
        && exists(/databases/$(database)/documents/jobs/$(resource.data.jobId))
        && projectHasCanonicalAssignment(
          get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.projectId,
          resource.data.builderId
        )
        && (
          isBuilder()
            && resource.data.builderId == request.auth.uid
            && resource.data.kind in ["reference", "completion"]
            && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.status
              in ["approved", "needs_correction"]
          || isManager()
            && resource.data.kind == "feedback"
            && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.status
              == "waiting_review"
        );
    }

    match /timeTracking/{entryId} {
      allow read: if isManager() || ownsExistingDocument("builderId");
      allow create: if isBuilder()
        && validId(entryId)
        && validTimeEntryDocument(request.resource.data)
        && request.resource.data.builderId == request.auth.uid
        && request.resource.data.clockIn == request.time
        && request.resource.data.clockOut == null
        && ownsProject(request.resource.data.projectId)
        && activeMarkerAfterMatches(entryId, request.resource.data.projectId);
      allow update: if isBuilder()
        && resource.data.builderId == request.auth.uid
        && validTimeEntryDocument(request.resource.data)
        && ownsProject(resource.data.projectId)
        && resource.data.clockOut == null
        && request.resource.data.clockOut == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["clockOut"])
        && (
          !exists(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid))
          || exists(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid))
            && get(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid)).data.entryId
              == entryId
            && (
              !existsAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid))
              || getAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid)).data.entryId
                != entryId
            )
        );
      allow delete: if false;
    }

    match /activeTimeEntries/{builderId} {
      allow read: if isManager() || (
        isBuilder() && builderId == request.auth.uid
      );
      allow create: if isBuilder()
        && builderId == request.auth.uid
        && request.resource.data.keys().hasOnly(["builderId", "entryId", "projectId", "updatedAt"])
        && request.resource.data.builderId == request.auth.uid
        && validId(request.resource.data.entryId)
        && validId(request.resource.data.projectId)
        && request.resource.data.updatedAt == request.time
        && activeEntryAfterIsValid(
          request.resource.data.entryId,
          request.resource.data.projectId
        );
      allow update: if isBuilder()
        && builderId == request.auth.uid
        && resource.data.builderId == request.auth.uid
        && request.resource.data.keys().hasOnly(["builderId", "entryId", "projectId", "updatedAt"])
        && request.resource.data.builderId == request.auth.uid
        && request.resource.data.entryId != resource.data.entryId
        && validId(request.resource.data.projectId)
        && request.resource.data.updatedAt == request.time
        && activeEntryAfterIsValid(
          request.resource.data.entryId,
          request.resource.data.projectId
        )
        && existsAfter(/databases/$(database)/documents/timeTracking/$(resource.data.entryId))
        && getAfter(/databases/$(database)/documents/timeTracking/$(resource.data.entryId)).data.clockOut
          == request.time;
      allow delete: if isBuilder()
        && builderId == request.auth.uid
        && resource.data.builderId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/timeTracking/$(resource.data.entryId))
        && getAfter(/databases/$(database)/documents/timeTracking/$(resource.data.entryId)).data.clockOut
          == request.time;
    }

    match /projectSwitches/{switchId} {
      allow read: if isManager() || ownsExistingDocument("builderId");
      allow create: if isBuilder()
        && validId(switchId)
        && request.resource.data.keys().hasOnly([
          "builderId", "fromProjectId", "toProjectId", "travelEntryId",
          "travelTimeMinutes", "switchedAt", "arrivedAt"
        ])
        && request.resource.data.builderId == request.auth.uid
        && request.resource.data.travelEntryId == switchId
        && request.resource.data.fromProjectId != request.resource.data.toProjectId
        && request.resource.data.travelTimeMinutes == null
        && request.resource.data.switchedAt == request.time
        && request.resource.data.arrivedAt == null
        && projectHasCanonicalAssignment(
          request.resource.data.fromProjectId,
          request.auth.uid
        )
        && projectHasCanonicalAssignment(
          request.resource.data.toProjectId,
          request.auth.uid
        )
        && activeEntryAfterIsValid(switchId, request.resource.data.fromProjectId)
        && activeMarkerAfterMatches(switchId, request.resource.data.fromProjectId);
      allow update: if isBuilder()
        && resource.data.builderId == request.auth.uid
        && request.resource.data.builderId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "builderId", "fromProjectId", "toProjectId", "travelEntryId",
          "travelTimeMinutes", "switchedAt", "arrivedAt"
        ])
        && validId(request.resource.data.fromProjectId)
        && validId(request.resource.data.toProjectId)
        && request.resource.data.fromProjectId != request.resource.data.toProjectId
        && request.resource.data.travelEntryId == switchId
        && request.resource.data.switchedAt is timestamp
        && projectHasCanonicalAssignment(
          request.resource.data.fromProjectId,
          request.auth.uid
        )
        && projectHasCanonicalAssignment(
          request.resource.data.toProjectId,
          request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["arrivedAt"])
        && (!resource.data.keys().hasAny(["arrivedAt"]) || resource.data.arrivedAt == null)
        && request.resource.data.arrivedAt == request.time
        && request.resource.data.travelTimeMinutes == null
        && existsAfter(/databases/$(database)/documents/timeTracking/$(resource.data.travelEntryId))
        && getAfter(/databases/$(database)/documents/timeTracking/$(resource.data.travelEntryId)).data.clockOut
          == request.time
        && existsAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid)).data.projectId
          == resource.data.toProjectId
        && getAfter(/databases/$(database)/documents/activeTimeEntries/$(request.auth.uid)).data.updatedAt
          == request.time;
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isManager() || (
        isBuilder() && resource.data.uploadedBy == request.auth.uid
      );
      allow write: if false;
    }

    match /dailyReports/{reportId} {
      allow read: if isManager() || (
        isBuilder()
        && resource.data.builderId == request.auth.uid
        && ownsProject(resource.data.projectId)
      );
      allow create: if isBuilder()
        && request.resource.data.keys().hasOnly([
          "builderId", "projectId", "date", "description", "photoPaths", "createdAt"
        ])
        && request.resource.data.builderId == request.auth.uid
        && request.resource.data.projectId is string
        && ownsProject(request.resource.data.projectId)
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 5000
        && request.resource.data.photoPaths is list
        && request.resource.data.photoPaths.size() <= 10
        && validDailyReportPhotoAt(0, request.auth.uid, reportId)
        && validDailyReportPhotoAt(1, request.auth.uid, reportId)
        && validDailyReportPhotoAt(2, request.auth.uid, reportId)
        && validDailyReportPhotoAt(3, request.auth.uid, reportId)
        && validDailyReportPhotoAt(4, request.auth.uid, reportId)
        && validDailyReportPhotoAt(5, request.auth.uid, reportId)
        && validDailyReportPhotoAt(6, request.auth.uid, reportId)
        && validDailyReportPhotoAt(7, request.auth.uid, reportId)
        && validDailyReportPhotoAt(8, request.auth.uid, reportId)
        && validDailyReportPhotoAt(9, request.auth.uid, reportId)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /riskAssessments/{assessmentId} {
      allow read: if canAccessRiskAssessment();
      allow create: if isManager()
        && request.resource.data.keys().hasOnly([
          "projectId", "title", "filePath", "fileName", "contentType", "fileSize",
          "uploadedBy", "createdAt"
        ])
        && request.resource.data.projectId is string
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.filePath is string
        && request.resource.data.filePath.matches(
          "^documents/" + request.resource.data.projectId + "/" + assessmentId + "/[^/]+$"
        )
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 180
        && request.resource.data.contentType == "application/pdf"
        && request.resource.data.fileSize is number
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 10 * 1024 * 1024
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isManager();
    }

    match /riskAssessmentSignatures/{signatureId} {
      allow read: if isManager() || (
        isBuilder()
        && resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/riskAssessments/$(resource.data.riskAssessmentId))
        && ownsProject(get(/databases/$(database)/documents/riskAssessments/$(resource.data.riskAssessmentId)).data.projectId)
      );
      allow create: if isBuilder()
        && request.resource.data.keys().hasOnly(["riskAssessmentId", "userId", "signedAt"])
        && validId(request.resource.data.riskAssessmentId)
        && signatureId == request.resource.data.riskAssessmentId + "_" + request.auth.uid
        && exists(/databases/$(database)/documents/riskAssessments/$(request.resource.data.riskAssessmentId))
        && ownsProject(get(/databases/$(database)/documents/riskAssessments/$(request.resource.data.riskAssessmentId)).data.projectId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.signedAt == request.time;
      allow update, delete: if false;
    }

    match /storageMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /storageTools/{toolId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /toolRequests/{requestId} {
      allow read: if isManager() || (isBuilder() && resource.data.requestedBy == request.auth.uid);
      allow create: if isBuilder()
        && request.resource.data.keys().hasOnly([
          "toolId", "projectId", "requestedBy", "requestedByName", "requestedAt", "status",
          "notes", "approvedBy", "approvedAt", "pickedUpBy", "pickedUpAt", "deliveredBy",
          "deliveredAt", "returnedBy", "returnedAt", "rejectionReason", "checkoutId",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.requestedBy == request.auth.uid
        && requestedNameMatchesAuth("requestedByName")
        && request.resource.data.status == "pending"
        && request.resource.data.approvedBy == null
        && request.resource.data.pickedUpBy == null
        && request.resource.data.deliveredBy == null
        && request.resource.data.returnedBy == null
        && request.resource.data.checkoutId == null
        && exists(/databases/$(database)/documents/storageTools/$(request.resource.data.toolId))
        && get(/databases/$(database)/documents/storageTools/$(request.resource.data.toolId)).data.status == "available"
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && ownsProject(request.resource.data.projectId);
      allow update: if isManager()
        && request.resource.data.toolId == resource.data.toolId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.requestedByName == resource.data.requestedByName
        && validToolRequestTransition();
      allow delete: if isManager();
    }

    match /toolCheckouts/{checkoutId} {
      allow read: if isManager() || (isBuilder() && resource.data.checkedOutBy == request.auth.uid);
      allow create, update, delete: if isManager();
    }

    match /materialTransfers/{transferId} {
      allow read: if isManager();
      allow create: if isManager()
        && request.resource.data.keys().hasOnly([
          "materialId", "materialName", "materialUnit", "projectId", "projectName",
          "quantity", "transferredBy", "transferredByName", "transferredAt", "notes"
        ])
        && request.resource.data.materialId is string
        && request.resource.data.projectId is string
        && request.resource.data.transferredBy == request.auth.uid
        && requestedNameMatchesAuth("transferredByName")
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 1000000
        && request.resource.data.transferredAt is timestamp
        && (request.resource.data.notes == null || (
          request.resource.data.notes is string
          && request.resource.data.notes.size() <= 1000
        ))
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && exists(/databases/$(database)/documents/storageMaterials/$(request.resource.data.materialId))
        && request.resource.data.projectName
          == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.name
        && request.resource.data.materialName
          == get(/databases/$(database)/documents/storageMaterials/$(request.resource.data.materialId)).data.name
        && request.resource.data.materialUnit
          == get(/databases/$(database)/documents/storageMaterials/$(request.resource.data.materialId)).data.unit
        && validStockDecrement(request.resource.data.materialId, request.resource.data.quantity);
      allow update, delete: if false;
    }

    match /materialUsage/{usageId} {
      allow read: if isManager() || (isBuilder() && resource.data.usedBy == request.auth.uid);
      allow create: if isManager()
        && request.resource.data.keys().hasOnly([
          "projectId", "projectName", "materialId", "materialName", "materialUnit", "jobId",
          "quantityUsed", "usedBy", "usedByName", "date", "notes", "createdAt"
        ])
        && request.resource.data.materialId is string
        && request.resource.data.projectId is string
        && request.resource.data.usedBy == request.auth.uid
        && requestedNameMatchesAuth("usedByName")
        && request.resource.data.quantityUsed is number
        && request.resource.data.quantityUsed > 0
        && request.resource.data.quantityUsed <= 1000000
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.createdAt is timestamp
        && (request.resource.data.notes == null || (
          request.resource.data.notes is string
          && request.resource.data.notes.size() <= 1000
        ))
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && exists(/databases/$(database)/documents/storageMaterials/$(request.resource.data.materialId))
        && request.resource.data.projectName
          == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.name
        && request.resource.data.materialName
          == get(/databases/$(database)/documents/storageMaterials/$(request.resource.data.materialId)).data.name
        && request.resource.data.materialUnit
          == get(/databases/$(database)/documents/storageMaterials/$(request.resource.data.materialId)).data.unit
        && (request.resource.data.jobId == null || (
          request.resource.data.jobId is string
          && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
          && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.projectId
            == request.resource.data.projectId
        ))
        && validStockDecrement(request.resource.data.materialId, request.resource.data.quantityUsed);
      allow update, delete: if false;
    }

    match /materialDeliveryRequests/{requestId} {
      allow read: if isManager() || (isBuilder() && resource.data.userId == request.auth.uid);
      allow create: if isBuilder()
        && request.resource.data.keys().hasOnly([
          "projectId", "userId", "requestedByName", "status", "notes", "createdAt",
          "resolvedAt", "resolvedBy"
        ])
        && request.resource.data.userId == request.auth.uid
        && requestedNameMatchesAuth("requestedByName")
        && request.resource.data.status == "pending"
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null
        && request.resource.data.createdAt is timestamp
        && (request.resource.data.notes == null || (
          request.resource.data.notes is string
          && request.resource.data.notes.size() <= 1000
        ))
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && ownsProject(request.resource.data.projectId);
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "resolvedAt", "resolvedBy"
        ])
        && validMaterialDeliveryTransition()
        && (
          (request.resource.data.status == "in_progress"
            && request.resource.data.resolvedAt == null
            && request.resource.data.resolvedBy == null)
          || (request.resource.data.status in ["delivered", "rejected"]
            && request.resource.data.resolvedAt is timestamp
            && request.resource.data.resolvedBy == request.auth.uid)
        );
      allow delete: if false;
    }

    match /materialDeliveryItems/{itemId} {
      allow read: if isManager() || (
        isBuilder()
        && get(/databases/$(database)/documents/materialDeliveryRequests/$(resource.data.requestId)).data.userId == request.auth.uid
      );
      allow create: if isBuilder()
        && request.resource.data.keys().hasOnly(["requestId", "materialId", "quantity", "createdAt"])
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 1000000
        && request.resource.data.createdAt is timestamp
        && !exists(/databases/$(database)/documents/materialDeliveryRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/materialDeliveryRequests/$(request.resource.data.requestId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/materialDeliveryRequests/$(request.resource.data.requestId)).data.status == "pending"
        && exists(/databases/$(database)/documents/storageMaterials/$(request.resource.data.materialId));
      allow update, delete: if false;
    }

    match /rubbishCollectionRequests/{requestId} {
      allow read: if isManager() || (isBuilder() && resource.data.userId == request.auth.uid);
      allow create: if isBuilder()
        && request.resource.data.keys().hasOnly([
          "userId", "requestedByName", "projectId", "photoPaths", "description", "status",
          "createdAt", "resolvedAt", "resolvedBy"
        ])
        && request.resource.data.userId == request.auth.uid
        && requestedNameMatchesAuth("requestedByName")
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null
        && request.resource.data.photoPaths is list
        && request.resource.data.photoPaths.size() > 0
        && request.resource.data.photoPaths.size() <= 10
        && validRubbishPhotoAt(0, requestId)
        && validRubbishPhotoAt(1, requestId)
        && validRubbishPhotoAt(2, requestId)
        && validRubbishPhotoAt(3, requestId)
        && validRubbishPhotoAt(4, requestId)
        && validRubbishPhotoAt(5, requestId)
        && validRubbishPhotoAt(6, requestId)
        && validRubbishPhotoAt(7, requestId)
        && validRubbishPhotoAt(8, requestId)
        && validRubbishPhotoAt(9, requestId)
        && (request.resource.data.description == null || (
          request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
        ))
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && ownsProject(request.resource.data.projectId);
      allow update: if isManager()
        && resource.data.status == "pending"
        && request.resource.data.status == "resolved"
        && request.resource.data.resolvedAt is timestamp
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "resolvedAt", "resolvedBy"
        ]);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
