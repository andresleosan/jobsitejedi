rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn() && request.auth.token.role == "manager";
    }

    function isBuilder() {
      return isSignedIn() && request.auth.token.role == "builder";
    }

    function ownsNewDocument(field) {
      return isBuilder() && request.resource.data[field] == request.auth.uid;
    }

    function ownsExistingDocument(field) {
      return isBuilder() && resource.data[field] == request.auth.uid;
    }

    function ownsUpdatedDocument(field) {
      return ownsExistingDocument(field) && ownsNewDocument(field);
    }

    function roleClaimIsImmutable() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
    }

    match /users/{userId} {
      allow get, list: if isManager() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(["role"]);
      allow update: if roleClaimIsImmutable() && (
        isManager() || (isSignedIn() && request.auth.uid == userId)
      );
      allow delete: if isManager() || (isSignedIn() && request.auth.uid == userId);
    }

    match /projects/{projectId} {
      allow read: if isManager() || ownsExistingDocument("ownerId");
      allow create: if isManager() || ownsNewDocument("ownerId");
      allow update: if isManager() || ownsUpdatedDocument("ownerId");
      allow delete: if isManager() || ownsExistingDocument("ownerId");
    }

    match /jobs/{jobId} {
      allow read: if isManager() || ownsExistingDocument("builderId");
      allow create: if isManager() || ownsNewDocument("builderId");
      allow update: if isManager() || (
        ownsUpdatedDocument("builderId")
        && request.resource.data.status == "waiting_review"
        && resource.data.status in ["approved", "needs_correction"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
      );
      allow delete: if isManager() || ownsExistingDocument("builderId");
    }

    match /jobCompletions/{completionId} {
      allow read: if isManager() || ownsExistingDocument("builderId");
      allow create: if isManager() || ownsNewDocument("builderId");
      allow update: if isManager() || ownsUpdatedDocument("builderId");
      allow delete: if isManager() || ownsExistingDocument("builderId");
    }

    match /jobPhotos/{photoId} {
      allow read: if isManager() || ownsExistingDocument("builderId");
      allow create: if isManager() || ownsNewDocument("builderId");
      allow update: if isManager() || ownsUpdatedDocument("builderId");
      allow delete: if isManager() || ownsExistingDocument("builderId");
    }

    match /timeTracking/{entryId} {
      allow read: if isManager() || ownsExistingDocument("builderId");
      allow create: if isManager() || ownsNewDocument("builderId");
      allow update: if isManager() || ownsUpdatedDocument("builderId");
      allow delete: if isManager() || ownsExistingDocument("builderId");
    }

    match /projectSwitches/{switchId} {
      allow read: if isManager() || ownsExistingDocument("builderId");
      allow create: if isManager() || ownsNewDocument("builderId");
      allow update: if isManager() || ownsUpdatedDocument("builderId");
      allow delete: if isManager() || ownsExistingDocument("builderId");
    }

    match /invitations/{invitationId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /storageMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /storageTools/{toolId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /toolRequests/{requestId} {
      allow read: if isManager() || (isBuilder() && resource.data.requestedBy == request.auth.uid);
      allow create: if isBuilder() && request.resource.data.requestedBy == request.auth.uid;
      allow update: if isManager();
      allow delete: if isManager();
    }

    match /toolCheckouts/{checkoutId} {
      allow read: if isManager() || (isBuilder() && resource.data.checkedOutBy == request.auth.uid);
      allow create: if (isManager() || isBuilder())
        && request.resource.data.checkedOutBy == request.auth.uid;
      allow update: if isManager() || (
        isBuilder()
        && resource.data.checkedOutBy == request.auth.uid
        && request.resource.data.checkedOutBy == resource.data.checkedOutBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "returnedAt", "returnedBy", "conditionOnReturn", "notes"
        ])
      );
      allow delete: if isManager();
    }

    match /materialTransfers/{transferId} {
      allow read, create: if isManager();
      allow update, delete: if isManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
