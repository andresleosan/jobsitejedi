rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn() && request.auth.token.role == "manager";
    }

    function isBuilder() {
      return isSignedIn() && request.auth.token.role == "builder";
    }

    function isValidUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("(image|application)/.*");
    }

    function isValidImageUpload() {
      return request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    function isValidInvoiceUpload() {
      return request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches("image/.*")
          || request.resource.contentType == "application/pdf"
        );
    }

    match /jobs/{jobId}/{builderId}/{allPaths=**} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update: if isManager() || (isBuilder() && request.auth.uid == builderId && isValidUpload());
      allow delete: if isManager() || (isBuilder() && request.auth.uid == builderId);
    }

    match /jobs/{jobId}/manager/{allPaths=**} {
      allow read: if isManager() || isBuilder();
      allow create, update: if isManager() && isValidUpload();
      allow delete: if isManager();
    }

    match /dailyReports/{builderId}/{allPaths=**} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update: if isManager() || (isBuilder() && request.auth.uid == builderId && isValidUpload());
      allow delete: if isManager() || (isBuilder() && request.auth.uid == builderId);
    }

    match /invoices/{builderId}/{invoiceId}/{fileName} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create: if isBuilder()
        && request.auth.uid == builderId
        && resource == null
        && isValidInvoiceUpload()
        && !firestore.exists(/databases/(default)/documents/invoices/$(invoiceId));
      allow update: if false;
      allow delete: if isBuilder()
        && request.auth.uid == builderId
        && !firestore.exists(/databases/(default)/documents/invoices/$(invoiceId));
    }

    match /documents/{userId}/{allPaths=**} {
      allow read: if isManager() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isManager() || (isSignedIn() && request.auth.uid == userId && isValidUpload());
      allow delete: if isManager() || (isSignedIn() && request.auth.uid == userId);
    }

    match /materials/{builderId}/{allPaths=**} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update: if isManager() || (isBuilder() && request.auth.uid == builderId && isValidUpload());
      allow delete: if isManager() || (isBuilder() && request.auth.uid == builderId);
    }

    match /rubbish/{builderId}/{requestId}/{fileName} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update: if isBuilder()
        && request.auth.uid == builderId
        && isValidImageUpload()
        && !firestore.exists(
          /databases/(default)/documents/rubbishCollectionRequests/$(requestId)
        );
      allow delete: if isBuilder()
        && request.auth.uid == builderId
        && !firestore.exists(
          /databases/(default)/documents/rubbishCollectionRequests/$(requestId)
        );
    }

    match /voiceNotes/{builderId}/{allPaths=**} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update: if isManager() || (isBuilder() && request.auth.uid == builderId && isValidUpload());
      allow delete: if isManager() || (isBuilder() && request.auth.uid == builderId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
