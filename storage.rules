rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn() && request.auth.token.role in ["admin", "manager"];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isBuilder() {
      return isSignedIn() && request.auth.token.role == "builder";
    }

    function ownsProject(projectId) {
      return isBuilder()
        && firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.builderId == request.auth.uid
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function jobHasCanonicalAssignment(jobId, builderId) {
      return firestore.exists(/databases/(default)/documents/jobs/$(jobId))
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.builderId == builderId
        && firestore.exists(
          /databases/(default)/documents/projects/$(
            firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.projectId
          )
        )
        && firestore.get(
          /databases/(default)/documents/projects/$(
            firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.projectId
          )
        ).data.builderId == builderId
        && firestore.get(
          /databases/(default)/documents/projects/$(
            firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.projectId
          )
        ).data.ownerId == builderId;
    }

    function jobStatusIs(jobId, allowedStatuses) {
      return firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.status
        in allowedStatuses;
    }

    function canReadAssignedJobFile(jobId, builderId) {
      return jobHasCanonicalAssignment(jobId, builderId)
        && (isManager() || (isBuilder() && request.auth.uid == builderId));
    }

    function canBuilderWriteAssignedJobFile(jobId, builderId, kind) {
      return isBuilder()
        && request.auth.uid == builderId
        && resource == null
        && kind in ["reference", "completion"]
        && jobHasCanonicalAssignment(jobId, builderId)
        && jobStatusIs(jobId, ["approved", "needs_correction"])
        && isValidImageUpload();
    }

    function canManagerWriteFeedback(jobId, builderId, kind) {
      return isManager()
        && resource == null
        && kind == "feedback"
        && jobHasCanonicalAssignment(jobId, builderId)
        && jobStatusIs(jobId, ["waiting_review"])
        && isValidImageUpload();
    }

    function isValidUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("(image|application)/.*");
    }

    function isValidImageUpload() {
      return request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    function isValidInvoiceUpload() {
      return request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches("image/.*")
          || request.resource.contentType == "application/pdf"
      );
    }

    function isValidSpreadsheetUpload() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "application/vnd.ms-excel",
          "text/csv",
          "text/tab-separated-values",
          "application/csv"
        ];
    }

    match /jobs/{jobId}/{builderId}/{kind}/{fileName} {
      allow read: if canReadAssignedJobFile(jobId, builderId);
      allow create: if canBuilderWriteAssignedJobFile(jobId, builderId, kind)
        || canManagerWriteFeedback(jobId, builderId, kind);
      allow update: if false;
      allow delete: if (
          isBuilder()
          && request.auth.uid == builderId
          && kind in ["reference", "completion"]
          && jobHasCanonicalAssignment(jobId, builderId)
          && jobStatusIs(jobId, ["approved", "needs_correction"])
        ) || (
          isManager()
          && kind == "feedback"
          && jobHasCanonicalAssignment(jobId, builderId)
          && jobStatusIs(jobId, ["waiting_review"])
        );
    }

    match /jobs/{jobId}/{builderId}/{kind}/thumbnails/{fileName} {
      allow read: if canReadAssignedJobFile(jobId, builderId);
      allow create: if canBuilderWriteAssignedJobFile(jobId, builderId, kind)
        || canManagerWriteFeedback(jobId, builderId, kind);
      allow update: if false;
      allow delete: if (
          isBuilder()
          && request.auth.uid == builderId
          && kind in ["reference", "completion"]
          && jobHasCanonicalAssignment(jobId, builderId)
          && jobStatusIs(jobId, ["approved", "needs_correction"])
        ) || (
          isManager()
          && kind == "feedback"
          && jobHasCanonicalAssignment(jobId, builderId)
          && jobStatusIs(jobId, ["waiting_review"])
        );
    }

    match /jobs/{jobId}/manager/{allPaths=**} {
      allow read: if isManager() || (
        isBuilder()
        && firestore.exists(/databases/(default)/documents/jobs/$(jobId))
        && jobHasCanonicalAssignment(
          jobId,
          firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.builderId
        )
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.builderId
          == request.auth.uid
      );
      allow create: if isManager()
        && resource == null
        && firestore.exists(/databases/(default)/documents/jobs/$(jobId))
        && jobHasCanonicalAssignment(
          jobId,
          firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.builderId
        )
        && jobStatusIs(jobId, ["waiting_review"])
        && isValidImageUpload();
      allow update: if false;
      allow delete: if isManager()
        && firestore.exists(/databases/(default)/documents/jobs/$(jobId))
        && jobHasCanonicalAssignment(
          jobId,
          firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.builderId
        )
        && jobStatusIs(jobId, ["waiting_review"]);
    }

    match /dailyReports/{builderId}/{reportId}/{allPaths=**} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId &&
        firestore.exists(/databases/(default)/documents/dailyReports/$(reportId)) &&
        ownsProject(firestore.get(/databases/(default)/documents/dailyReports/$(reportId)).data.projectId));
      allow create: if isBuilder()
        && request.auth.uid == builderId
        && firestore.exists(/databases/(default)/documents/dailyReports/$(reportId))
        && firestore.get(/databases/(default)/documents/dailyReports/$(reportId)).data.builderId == request.auth.uid
        && isValidUpload();
      allow update, delete: if false;
    }

    match /invoice-quarantine/{builderId}/{invoiceId}/{fileName} {
      allow read: if false;
      allow create: if isBuilder()
        && request.auth.uid == builderId
        && fileName == "upload"
        && resource == null
        && isValidInvoiceUpload()
        && !firestore.exists(/databases/(default)/documents/invoices/$(invoiceId));
      allow update: if false;
      allow delete: if isBuilder()
        && request.auth.uid == builderId
        && !firestore.exists(/databases/(default)/documents/invoices/$(invoiceId));
    }

    match /invoices/{builderId}/{invoiceId}/{fileName} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update, delete: if false;
    }

    match /job-imports/{managerId}/{fileName} {
      allow read: if isManager() && request.auth.uid == managerId;
      allow create: if isManager()
        && request.auth.uid == managerId
        && resource == null
        && fileName.matches("^[A-Za-z0-9][A-Za-z0-9._-]{0,179}$")
        && fileName.matches(".*\\.(csv|tsv|xlsx)$")
        && isValidSpreadsheetUpload();
      allow update: if false;
      allow delete: if isManager() && request.auth.uid == managerId;
    }

    match /documents/{projectId}/{documentId}/{allPaths=**} {
      allow read: if isManager() || ownsProject(projectId);
      allow create: if isManager() && isValidUpload();
      allow update, delete: if isManager();
    }

    match /materials/{builderId}/{allPaths=**} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update: if isManager() || (isBuilder() && request.auth.uid == builderId && isValidUpload());
      allow delete: if isManager() || (isBuilder() && request.auth.uid == builderId);
    }

    match /rubbish/{builderId}/{requestId}/{fileName} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update: if isBuilder()
        && request.auth.uid == builderId
        && isValidImageUpload()
        && !firestore.exists(
          /databases/(default)/documents/rubbishCollectionRequests/$(requestId)
        );
      allow delete: if isBuilder()
        && request.auth.uid == builderId
        && !firestore.exists(
          /databases/(default)/documents/rubbishCollectionRequests/$(requestId)
        );
    }

    match /voiceNotes/{builderId}/{allPaths=**} {
      allow read: if isManager() || (isBuilder() && request.auth.uid == builderId);
      allow create, update: if isManager() || (isBuilder() && request.auth.uid == builderId && isValidUpload());
      allow delete: if isManager() || (isBuilder() && request.auth.uid == builderId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
